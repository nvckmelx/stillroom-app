# Stillroom CMS configuration. Copy to .env next to src/ (NOT inside public_html) and fill in.
# Never commit .env — the repository is public.

# Public address of the site, no trailing slash. Used in API media URLs, canonical links and the sitemap.
APP_URL=https://example.com
APP_DEBUG=false

# Database. Hostinger: hPanel → Databases → MySQL Databases (host is usually localhost).
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u000000000_stillroom
DB_USER=u000000000_stillroom
DB_PASS=change-me
# Local development / tests instead of MySQL:
# DB_DRIVER=sqlite
# DB_PATH=storage/database.sqlite

# Folder that is the web root, relative to this file. Hostinger: public_html. Local repo layout: public.
PUBLIC_DIR=public_html

# One-time web installer at /install. Set 16+ random characters, run the installer, then delete this line.
INSTALL_TOKEN=

# Upload limits (MB). The PHP limits in public_html/.user.ini must be at least this large.
MAX_AUDIO_MB=60
MAX_IMAGE_MB=8

# How many backup zips to keep in storage/backups
BACKUP_KEEP=14
